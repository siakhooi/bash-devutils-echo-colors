#!/usr/bin/env bash
#
# Description: highlights a word in magenta in standard input.
# Usage: highlight.magenta [options]
#

set -euo pipefail

# ===== Constants =====
readonly color='1;35'
readonly escape=$'\033'

if [[ $# -ne 1 ]]; then
  echo "Usage: $(basename "$0") word" >&2
  exit 1
fi

readonly word=$1
# shellcheck disable=SC2016
escaped_word=$(printf '%s\n' "$word" | sed 's/[[\.*^$()+?{|]/\\&/g')
readonly escaped_word

sed "s,$escaped_word,${escape}[${color}m&${escape}[0m,g"
